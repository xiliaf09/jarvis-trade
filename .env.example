# ============================================================
# JARVIS TRADE — Environment variables
# ============================================================

# === REQUIRED ===
TELEGRAM_BOT_TOKEN=                # From @BotFather
ENCRYPTION_KEY=                    # Master password for wallet encryption (min 32 chars, random)
AUTHORIZED_USERS=                  # Comma-separated Telegram user IDs (e.g. "7042516399,123456789")

# === RPC ENDPOINTS (required for trading) ===
BASE_RPC_URL=                      # https://base.drpc.org or your private RPC
ETHEREUM_RPC_URL=                  # https://eth.drpc.org or your private RPC

# === OPTIONAL ===
PORT=3335                          # HTTP API port (for future Jarvis Hub integration)
HUB_RELAY_URL=                     # Jarvis Hub URL if integrating
